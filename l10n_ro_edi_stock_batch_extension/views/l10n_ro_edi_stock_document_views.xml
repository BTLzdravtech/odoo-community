<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add the Batch Transfer column to the eTransport Documents views.
         batch_id only exists on l10n_ro_edi.document when l10n_ro_edi_stock_batch
         is installed, so it is added here (this module depends on it) rather
         than in l10n_ro_edi_stock_extension. -->
    <record id="view_l10n_ro_edi_stock_document_list_batch" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.document.list.batch</field>
        <field name="model">l10n_ro_edi.document</field>
        <field
            name="inherit_id"
            ref="l10n_ro_edi_stock_extension.view_l10n_ro_edi_stock_document_list"
        />
        <field name="arch" type="xml">
            <field name="picking_id" position="after">
                <field name="batch_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_l10n_ro_edi_stock_document_form_batch" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.document.form.batch</field>
        <field name="model">l10n_ro_edi.document</field>
        <field
            name="inherit_id"
            ref="l10n_ro_edi_stock_extension.view_l10n_ro_edi_stock_document_form"
        />
        <field name="arch" type="xml">
            <field name="picking_id" position="after">
                <field name="batch_id" />
            </field>
        </field>
    </record>

    <record id="view_l10n_ro_edi_stock_document_search_batch" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.document.search.batch</field>
        <field name="model">l10n_ro_edi.document</field>
        <field
            name="inherit_id"
            ref="l10n_ro_edi_stock_extension.view_l10n_ro_edi_stock_document_search"
        />
        <field name="arch" type="xml">
            <field name="picking_id" position="after">
                <field name="batch_id" />
            </field>
        </field>
    </record>
</odoo>
